# ==============================================================================
# BIZBEIN INNOVATIONS PVT. LTD. — VERCEL ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. AUTHENTICATION & SECURITY
# Generate a secure 32+ character string (e.g. openssl rand -base64 32)
JWT_SECRET=bizbein_production_jwt_secret_change_in_production_2026

# Administrator Account
ADMIN_EMAIL=admin@bizbein.com
ADMIN_INITIAL_PASSWORD=Admin@12345

# 2. RESEND EMAIL SERVICE & OTP DISPATCH (https://resend.com)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=BizBein Security <onboarding@resend.dev>


# Option B: Direct SMTP / Gmail (Free, sends to any recipient)
# For Gmail: Use your Gmail address and a 16-character App Password (from myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=bizbein8@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM=BizBein Innovations <bizbein8@gmail.com>

# 3. WHATSAPP BUSINESS PLATFORM (Meta Developer Cloud API)
# Obtain your access token and phone ID from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_API_TOKEN=EAAG...your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=109876543210987
# Recipient mobile number for admin WhatsApp dispatch alerts (including country code)
ADMIN_WHATSAPP_NUMBER=+919915856540

# 4. SITE DOMAIN & DEPLOYMENT
NEXT_PUBLIC_BASE_URL=https://bizbein.com

# 5. FIREBASE AUTHENTICATION (https://console.firebase.google.com)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

